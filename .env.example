# Copie para .env.local e preencha.
# Números no formato internacional: 55 + DDD + número (só dígitos).

# WhatsApp de vendas da Multsystems
WHATSAPP_MULTSYSTEMS=551148948411

# API do catálogo da loja (a mesma que o site atual usa na busca). Se ficar vazio, usa a padrão.
CATALOGO_API_URL=https://multsystems.discloud.app/api/produtos

# WhatsApp da Total Tech (assistência técnica parceira). Se ficar vazio, usa o da Multsystems.
WHATSAPP_TOTALTECH=

# BotConversa (plano Pro): URL do webhook criado em Automações > Webhook. O site envia para ela os
# orçamentos, chamados, contatos, carrinhos e favoritos de quem deixou o telefone. Vazio = só log.
BOTCONVERSA_WEBHOOK_URL=

# Google Analytics 4 (ex.: G-XXXXXXXXXX). Vazio = sem GA (os eventos do funil continuam no log do servidor).
NEXT_PUBLIC_GA_ID=

# Endereço público do site: capa de link, sitemap, robots, links do BotConversa. Na Vercel, se ficar vazio, usa
# o endereço do próprio projeto (ex.: multsystems.vercel.app). Defina quando o domínio definitivo estiver no ar.
NEXT_PUBLIC_SITE_URL=https://www.multsystems.com.br
